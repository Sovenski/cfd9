float pivot_drift_thresh_low = is_gold_current ? 0.005 : is_dax_latest ? 0.0330 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? 0.0500 : is_spx_20260405_2059_salvaged_best ? 0.0303 : 0.009
float pivot_drift_gate_mult_low = is_gold_current ? 4.0 : is_dax_latest ? 4.4990 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? 3.3731 : is_spx_20260405_2059_salvaged_best ? 3.2778 : 4.0
int pivot_drift_confirm_bias_low = is_gold_current ? 0 : is_dax_latest ? 1 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? 0 : is_spx_20260405_2059_salvaged_best ? 2 : 1
bool use_price_gate_low = true
bool use_er_gate_low = is_gold_current ? false : is_dax_latest ? false : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? false : false
bool use_pivot_drift_low = true
bool er_directional_low = is_gold_current ? false : is_dax_latest ? false : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? false : false
bool use_trend_low = is_gold_current ? false : is_dax_latest ? true : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? true : false
bool use_volume_low = is_gold_current ? false : is_dax_latest ? false : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? false : false
bool use_momentum_low = is_gold_current ? false : is_dax_latest ? true : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? false : is_spx_20260405_2059_salvaged_best ? true : false
bool use_momentum_velocity_low = is_gold_current ? true : is_dax_latest ? false : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? true : true
bool use_volatility_low = is_gold_current ? true : is_dax_latest ? true : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? true : is_spx_20260405_2059_salvaged_best ? false : true
bool use_gjr_asym_low = is_gold_current ? false : is_dax_latest ? false : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow ? true : is_spx_20260405_heuristic_structural ? false : is_spx_20260405_2059_salvaged_best ? false : false
bool use_har_vol_low = is_gold_current ? false : is_dax_latest ? true : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? false : is_spx_20260405_2059_salvaged_best ? false : false
float gjr_vote_thresh_low = is_gold_current ? 0.15 : is_dax_latest ? 0.3039 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow ? 0.1911 : is_spx_20260405_heuristic_structural ? 0.1911 : is_spx_20260405_2059_salvaged_best ? 0.3984 : 0.15
float har_vote_thresh_low = is_gold_current ? 0.15 : is_dax_latest ? 0.4326 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? 0.1461 : is_spx_20260405_2059_salvaged_best ? 0.3033 : 0.15
string momentum_velocity_mode_low = is_gold_current ? "Reversal" : is_dax_latest ? "Reversal" : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? "Trend" : is_spx_20260405_2059_salvaged_best ? "Trend" : "Reversal"
float momentum_velocity_thresh_low = is_gold_current ? 0.007 : is_dax_latest ? 0.0475 : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? 0.0064 : is_spx_20260405_2059_salvaged_best ? 0.0285 : 0.0
string vola_method_low = is_gold_current ? "ATR" : is_dax_latest ? "Intraday" : is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural ? "ATR" : is_spx_20260405_2059_salvaged_best ? "Intraday" : "StdDev"

// Derived lookbacks.
int slope_delta_high = math.max(math.round(S_detect_high / 4), 2)
int vol_fast_len_high = math.max(math.round(S_detect_high / 4), 2)
int vol_slow_len_high = S_detect_high
int mom_lookback_high = S_detect_high
int vola_calc_len_high = S_detect_high
int vola_slope_lb_high = math.max(math.round(S_detect_high / 2), 2)

int slope_delta_low = math.max(math.round(S_detect_low / 4), 2)
int vol_fast_len_low = math.max(math.round(S_detect_low / 4), 2)
int vol_slow_len_low = S_detect_low
int mom_lookback_low = S_detect_low
int vola_calc_len_low = S_detect_low
int vola_slope_lb_low = math.max(math.round(S_detect_low / 2), 2)

// Multi-scale agreement per side.
[scales_high_high, scales_low_high, n_scales_high, agreement_high_high, agreement_low_high] = calc_agreement(scale_start_high, scale_end_high, scale_step_high, pct_extreme_high)
[scales_high_low, scales_low_low, n_scales_low, agreement_high_low, agreement_low_low] = calc_agreement(scale_start_low, scale_end_low, scale_step_low, pct_extreme_low)

if is_spx_20260329_1835_trial1225 or is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural
    float spx_low_count_sum =
         low_scale_flag(17, pct_extreme_low) +
         low_scale_flag(24, pct_extreme_low) +
         low_scale_flag(31, pct_extreme_low) +
         low_scale_flag(38, pct_extreme_low) +
         low_scale_flag(45, pct_extreme_low) +
         low_scale_flag(52, pct_extreme_low) +
         low_scale_flag(59, pct_extreme_low) +
         low_scale_flag(66, pct_extreme_low) +
         low_scale_flag(73, pct_extreme_low) +
         low_scale_flag(80, pct_extreme_low) +
         low_scale_flag(87, pct_extreme_low) +
         low_scale_flag(94, pct_extreme_low) +
         low_scale_flag(101, pct_extreme_low) +
         low_scale_flag(108, pct_extreme_low) +
         low_scale_flag(115, pct_extreme_low) +
         low_scale_flag(122, pct_extreme_low) +
         low_scale_flag(129, pct_extreme_low) +
         low_scale_flag(136, pct_extreme_low) +
         low_scale_flag(143, pct_extreme_low) +
         low_scale_flag(150, pct_extreme_low) +
         low_scale_flag(157, pct_extreme_low) +
         low_scale_flag(164, pct_extreme_low) +
         low_scale_flag(171, pct_extreme_low) +
         low_scale_flag(178, pct_extreme_low) +
         low_scale_flag(185, pct_extreme_low) +
         low_scale_flag(192, pct_extreme_low)
    scales_low_low := int(spx_low_count_sum)
    n_scales_low := 26
    agreement_low_low := spx_low_count_sum / 26.0

if is_spx_20260405_parity_highlow or is_spx_20260405_heuristic_structural
    float spx_high_count_sum =
         high_scale_flag(24, pct_extreme_high) +
         high_scale_flag(27, pct_extreme_high) +
         high_scale_flag(30, pct_extreme_high) +
         high_scale_flag(33, pct_extreme_high) +
         high_scale_flag(36, pct_extreme_high) +
         high_scale_flag(39, pct_extreme_high) +
         high_scale_flag(42, pct_extreme_high) +
         high_scale_flag(45, pct_extreme_high) +
         high_scale_flag(48, pct_extreme_high) +
         high_scale_flag(51, pct_extreme_high) +
         high_scale_flag(54, pct_extreme_high) +
         high_scale_flag(57, pct_extreme_high) +
         high_scale_flag(60, pct_extreme_high) +
         high_scale_flag(63, pct_extreme_high) +
         high_scale_flag(66, pct_extreme_high) +
         high_scale_flag(69, pct_extreme_high) +
         high_scale_flag(72, pct_extreme_high) +
         high_scale_flag(75, pct_extreme_high) +
         high_scale_flag(78, pct_extreme_high) +
         high_scale_flag(81, pct_extreme_high) +
         high_scale_flag(84, pct_extreme_high) +
         high_scale_flag(87, pct_extreme_high) +
         high_scale_flag(90, pct_extreme_high) +
         high_scale_flag(93, pct_extreme_high) +
         high_scale_flag(96, pct_extreme_high) +
         high_scale_flag(99, pct_extreme_high) +
         high_scale_flag(102, pct_extreme_high) +
         high_scale_flag(105, pct_extreme_high) +
         high_scale_flag(108, pct_extreme_high) +
         high_scale_flag(111, pct_extreme_high) +
         high_scale_flag(114, pct_extreme_high) +
         high_scale_flag(117, pct_extreme_high) +
         high_scale_flag(120, pct_extreme_high) +
         high_scale_flag(123, pct_extreme_high) +
         high_scale_flag(126, pct_extreme_high) +
         high_scale_flag(129, pct_extreme_high) +
         high_scale_flag(132, pct_extreme_high) +
         high_scale_flag(135, pct_extreme_high) +
         high_scale_flag(138, pct_extreme_high) +
         high_scale_flag(141, pct_extreme_high) +
         high_scale_flag(144, pct_extreme_high) +
         high_scale_flag(147, pct_extreme_high) +
         high_scale_flag(150, pct_extreme_high) +
         high_scale_flag(153, pct_extreme_high) +
         high_scale_flag(156, pct_extreme_high)
    scales_high_high := int(spx_high_count_sum)
    n_scales_high := 45
    agreement_high_high := spx_high_count_sum / 45.0

bool ms_agree_high = agreement_high_high >= min_agreement_high
bool ms_agree_low = agreement_low_low >= min_agreement_low

float ratio_detect_high = close / ta.sma(close, S_detect_high)
float ratio_detect_low = close / ta.sma(close, S_detect_low)
float pir_detect_high = pir_of(ratio_detect_high, math.max(S_detect_high, 20))
float pir_detect_low = pir_of(ratio_detect_low, math.max(S_detect_low, 20))

float scale_div_high = pir_detect_high - agreement_high_high
float scale_div_low = (1.0 - pir_detect_low) - agreement_low_low
bool scale_div_high_flag = math.abs(scale_div_high) > scale_div_thresh_high
bool scale_div_low_flag = math.abs(scale_div_low) > scale_div_thresh_low

// Trend per side.
float sma_val_high = ta.sma(close, S_detect_high)
float slope_val_high = sma_val_high > 0 ? nz(sma_val_high - sma_val_high[slope_delta_high]) / (slope_delta_high * sma_val_high) * 1000 : 0.0
float linreg_slope_high = ta.linreg(close, S_detect_high, 0) - ta.linreg(close, S_detect_high, 1)
float linreg_norm_high = sma_val_high > 0 ? linreg_slope_high / sma_val_high * 1000 : 0.0
bool trend_up_high = slope_val_high > slope_thresh_high and linreg_norm_high > slope_thresh_high

float sma_val_low = ta.sma(close, S_detect_low)
float slope_val_low = sma_val_low > 0 ? nz(sma_val_low - sma_val_low[slope_delta_low]) / (slope_delta_low * sma_val_low) * 1000 : 0.0
float linreg_slope_low = ta.linreg(close, S_detect_low, 0) - ta.linreg(close, S_detect_low, 1)
float linreg_norm_low = sma_val_low > 0 ? linreg_slope_low / sma_val_low * 1000 : 0.0
bool trend_down_low = slope_val_low < -slope_thresh_low and linreg_norm_low < -slope_thresh_low

// Duration at extremes per side.
var int dur_at_high = 0
var int dur_miss_high = 0
if agreement_high_high > dur_extreme_pct_high
    dur_at_high += 1
    dur_miss_high := 0
else
    dur_miss_high += 1
    if dur_miss_high > 1
        dur_at_high := 0
bool dur_high_flag = dur_at_high >= min_duration_high

var int dur_at_low = 0
var int dur_miss_low = 0
if agreement_low_low > dur_extreme_pct_low
    dur_at_low += 1
    dur_miss_low := 0
else
    dur_miss_low += 1
    if dur_miss_low > 1
        dur_at_low := 0
bool dur_low_flag = dur_at_low >= min_duration_low

// Volume surge per side.
float vol_surge_high = ta.sma(volume, vol_fast_len_high) / ta.sma(volume, vol_slow_len_high)
float vol_surge_low = ta.sma(volume, vol_fast_len_low) / ta.sma(volume, vol_slow_len_low)

// Momentum and momentum velocity per side.
float price_ret_high = nz((close - close[mom_lookback_high]) / close[mom_lookback_high])
float vol_ret_high = nz((volume - volume[mom_lookback_high]) / math.max(nz(volume[mom_lookback_high]), 1))
float mom_diverge_high = price_ret_high * vol_ret_high
float momentum_velocity_high = nz(price_ret_high - price_ret_high[1])
bool mom_vel_high_ok = momentum_velocity_mode_high == "Trend" ? momentum_velocity_high >= math.abs(momentum_velocity_thresh_high) : momentum_velocity_high <= -math.abs(momentum_velocity_thresh_high)

float price_ret_low = nz((close - close[mom_lookback_low]) / close[mom_lookback_low])
float vol_ret_low = nz((volume - volume[mom_lookback_low]) / math.max(nz(volume[mom_lookback_low]), 1))
float mom_diverge_low = price_ret_low * vol_ret_low
float momentum_velocity_low = nz(price_ret_low - price_ret_low[1])
bool mom_vel_low_ok = momentum_velocity_mode_low == "Trend" ? momentum_velocity_low <= -math.abs(momentum_velocity_thresh_low) : momentum_velocity_low >= math.abs(momentum_velocity_thresh_low)

// Volatility per side.
float vola_raw_high = vola_method_high == "ATR" ? ta.atr(vola_calc_len_high) : vola_method_high == "Intraday" ? ta.sma(close > 0 ? (high - low) / close : 0.0, vola_calc_len_high) : ta.stdev(close, vola_calc_len_high)
float vola_pos_high = pir_of(vola_raw_high, vola_range_len_high)
bool vola_elevated_high = vola_pos_high > vola_high_pct_high

float vola_raw_low = vola_method_low == "ATR" ? ta.atr(vola_calc_len_low) : vola_method_low == "Intraday" ? ta.sma(close > 0 ? (high - low) / close : 0.0, vola_calc_len_low) : ta.stdev(close, vola_calc_len_low)
float vola_pos_low = pir_of(vola_raw_low, vola_range_len_low)
bool vola_elevated_low = vola_pos_low > vola_high_pct_low

// Hard gates.
bool price_high_ok = not use_price_gate_high or high >= ta.highest(high, price_gate_lb_high)[1]
bool price_low_ok = not use_price_gate_low or low <= ta.lowest(low, price_gate_lb_low)[1]

float er_path_high = 0.0
for i = 0 to er_period_high - 1
    er_path_high += math.abs(close[i] - close[i + 1])
float er_net_high = er_directional_high ? close - close[er_period_high] : math.abs(close - close[er_period_high])
float er_val_high = er_path_high > 0 ? er_net_high / er_path_high : 0.0
bool er_gate_ok_high = not use_er_gate_high or er_val_high < nz(er_val_high[1], 0.0)

float er_path_low = 0.0
for i = 0 to er_period_low - 1
    er_path_low += math.abs(close[i] - close[i + 1])
float er_net_low = er_directional_low ? close - close[er_period_low] : math.abs(close - close[er_period_low])
float er_val_low = er_path_low > 0 ? er_net_low / er_path_low : 0.0
bool er_gate_ok_low = not use_er_gate_low or er_val_low < nz(er_val_low[1], 0.0)

// GJR + HAR votes.
[gjr_asym_norm, gjr_asym_ratio] = calc_gjr_asym()
bool gjr_high_vote = gjr_asym_norm <= -gjr_vote_thresh_high
bool gjr_low_vote = gjr_asym_norm >= gjr_vote_thresh_low
[har_vol_norm, har_vol_ratio] = calc_har_vol()
bool har_high_vote = har_vol_norm >= har_vote_thresh_high
bool har_low_vote = har_vol_norm >= har_vote_thresh_low

// Baseline pivots and pivot drift.
float baseline_ph = ta.pivothigh(high, baseline_lb, baseline_lb)
float baseline_pl = ta.pivotlow(low, baseline_lb, baseline_lb)

var array<float> confirmed_pivots = array.new_float()
float pivot_drift_high = nz(calc_pivot_drift(confirmed_pivots, pivot_drift_lookback_high), 0.0)
float pivot_drift_low = nz(calc_pivot_drift(confirmed_pivots, pivot_drift_lookback_low), 0.0)
if not na(baseline_ph)
    array.push(confirmed_pivots, baseline_ph)
if not na(baseline_pl)
    array.push(confirmed_pivots, baseline_pl)
bool pivot_drift_up_high = pivot_drift_high > pivot_drift_thresh_high
bool pivot_drift_down_high = pivot_drift_high < -pivot_drift_thresh_high
bool pivot_drift_gate_up_high = pivot_drift_high > (pivot_drift_thresh_high * pivot_drift_gate_mult_high)
bool pivot_drift_up_low = pivot_drift_low > pivot_drift_thresh_low

// Confirmation votes.
int ph_confirms = 0
ph_confirms += use_trend_high and trend_up_high ? 1 : 0
ph_confirms += use_pivot_drift_high and pivot_drift_down_high ? 1 : 0
ph_confirms += use_volume_high and vol_surge_high < (1.0 / vol_surge_thresh_high) ? 1 : 0
ph_confirms += use_momentum_high and mom_diverge_high < 0 ? 1 : 0
ph_confirms += use_momentum_velocity_high and mom_vel_high_ok ? 1 : 0
ph_confirms += use_volatility_high and vola_elevated_high ? 1 : 0
ph_confirms += use_gjr_asym_high and gjr_high_vote ? 1 : 0
ph_confirms += use_har_vol_high and har_high_vote ? 1 : 0

int pl_confirms = 0
pl_confirms += use_trend_low and trend_down_low ? 1 : 0
pl_confirms += use_pivot_drift_low and pivot_drift_up_low ? 1 : 0
pl_confirms += use_volume_low and vol_surge_low > vol_surge_thresh_low ? 1 : 0
pl_confirms += use_momentum_low and mom_diverge_low < 0 ? 1 : 0
pl_confirms += use_momentum_velocity_low and mom_vel_low_ok ? 1 : 0
pl_confirms += use_volatility_low and vola_elevated_low ? 1 : 0
pl_confirms += use_gjr_asym_low and gjr_low_vote ? 1 : 0
pl_confirms += use_har_vol_low and har_low_vote ? 1 : 0

int max_votes_high = (use_trend_high ? 1 : 0) + (use_volume_high ? 1 : 0) + (use_momentum_high ? 1 : 0) + (use_momentum_velocity_high ? 1 : 0) + (use_volatility_high ? 1 : 0) + (use_gjr_asym_high ? 1 : 0) + (use_har_vol_high ? 1 : 0)
int max_votes_low = (use_trend_low ? 1 : 0) + (use_volume_low ? 1 : 0) + (use_momentum_low ? 1 : 0) + (use_momentum_velocity_low ? 1 : 0) + (use_volatility_low ? 1 : 0) + (use_gjr_asym_low ? 1 : 0) + (use_har_vol_low ? 1 : 0)

int high_required = math.max(1, math.min(max_votes_high > 0 ? max_votes_high : 1, confirm_count_high + (use_pivot_drift_high and pivot_drift_up_high ? pivot_drift_confirm_bias_high : 0)))
int low_required = math.max(1, math.min(max_votes_low > 0 ? max_votes_low : 1, confirm_count_low - (use_pivot_drift_low and pivot_drift_up_low ? pivot_drift_confirm_bias_low : 0)))

bool gate_pass_high = price_high_ok and ms_agree_high and dur_high_flag and not scale_div_high_flag and er_gate_ok_high and (not use_pivot_drift_high or not pivot_drift_gate_up_high)
bool gate_pass_low = price_low_ok and ms_agree_low and dur_low_flag and not scale_div_low_flag and er_gate_ok_low

// Signal generation with cooldown.
var int bars_since_high_signal = 999
var int bars_since_low_signal = 999
bars_since_high_signal += 1
bars_since_low_signal += 1

bool pivot_high = gate_pass_high and ph_confirms >= high_required and bars_since_high_signal > cooldown_bars_high
bool pivot_low = gate_pass_low and pl_confirms >= low_required and bars_since_low_signal > cooldown_bars_low

if pivot_high
    bars_since_high_signal := 0
if pivot_low
    bars_since_low_signal := 0

// Visuals.
color bg_color = na
if show_bg
    if pivot_high
        bg_color := color.new(color.red, 78)
    else if pivot_low
        bg_color := color.new(color.green, 78)
bgcolor(bg_color)

plotshape(pivot_high and not pivot_high[1], title="Pivot High", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal)
plotshape(pivot_low and not pivot_low[1], title="Pivot Low", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal)
plotshape(show_baseline and not na(baseline_ph), title="Baseline High", style=shape.diamond, location=location.abovebar, color=color.new(color.purple, 20), offset=-baseline_lb, size=size.tiny)
plotshape(show_baseline and not na(baseline_pl), title="Baseline Low", style=shape.diamond, location=location.belowbar, color=color.new(color.purple, 20), offset=-baseline_lb, size=size.tiny)

if show_panel
    var table panel = table.new(position.bottom_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(panel, 0, 0, "Preset", text_color=color.gray, text_size=size.tiny)
    table.cell(panel, 1, 0, preset, text_color=color.yellow, text_size=size.tiny)
    table.cell(panel, 0, 1, "HIGH", text_color=color.red, text_size=size.tiny)
    table.cell(panel, 1, 1, "S=" + str.tostring(S_detect_high) + " C=" + str.tostring(confirm_count_high) + " PG=" + str.tostring(price_gate_lb_high), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 2, "HIGH votes", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 2, str.tostring(ph_confirms) + "/" + str.tostring(math.max(max_votes_high, high_required)), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 3, "HIGH accel", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 3, str.tostring(momentum_velocity_high, "#.####"), text_color=use_momentum_velocity_high ? color.aqua : color.gray, text_size=size.tiny)
    table.cell(panel, 0, 4, "LOW", text_color=color.green, text_size=size.tiny)
    table.cell(panel, 1, 4, "S=" + str.tostring(S_detect_low) + " C=" + str.tostring(confirm_count_low) + " PG=" + str.tostring(price_gate_lb_low), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 5, "LOW votes", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 5, str.tostring(pl_confirms) + "/" + str.tostring(math.max(max_votes_low, low_required)), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 6, "LOW drift", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 6, str.tostring(pivot_drift_low, "#.####"), text_color=use_pivot_drift_low ? color.aqua : color.gray, text_size=size.tiny)
    table.cell(panel, 0, 7, "Agreement", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 7, "H " + str.tostring(agreement_high_high, "#.##") + " | L " + str.tostring(agreement_low_low, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 8, "Signals", text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 8, (pivot_high ? "HIGH" : pivot_low ? "LOW" : "---"), text_color=color.white, text_size=size.tiny)

// Data window exports (high-side parity focus).
plot(agreement_high_high, "agreement_high_side", display=display.data_window)
plot(agreement_high_high, "dbg_agreement_high_high", display=display.data_window)
plot(agreement_low_high, "dbg_agreement_low_high", display=display.data_window)
plot(scales_high_high * 1.0, "dbg_scales_high_high", display=display.data_window)
plot(scales_low_high * 1.0, "dbg_scales_low_high", display=display.data_window)
plot(n_scales_high * 1.0, "dbg_n_scales_high", display=display.data_window)
plot(ms_agree_high ? 1.0 : 0.0, "dbg_ms_agree_high", display=display.data_window)
plot(dur_high_flag ? 1.0 : 0.0, "dbg_dur_high_flag", display=display.data_window)
plot(scale_div_high, "dbg_scale_div_high", display=display.data_window)
plot(scale_div_high_flag ? 1.0 : 0.0, "dbg_scale_div_high_flag", display=display.data_window)
plot(momentum_velocity_high, "momentum_velocity_high", display=display.data_window)
plot(pivot_drift_high, "pivot_drift_high", display=display.data_window)
plot(ph_confirms * 1.0, "ph_confirms", display=display.data_window)
plot(high_required * 1.0, "dbg_high_required", display=display.data_window)
plot(gate_pass_high ? 1.0 : 0.0, "dbg_gate_pass_high", display=display.data_window)
plot(bars_since_high_signal * 1.0, "dbg_bars_since_high_signal", display=display.data_window)
plot(pivot_high ? 1.0 : 0.0, "dbg_pivot_high_raw", display=display.data_window)
plot(trend_up_high ? 1.0 : 0.0, "dbg_high_vote_trend", display=display.data_window)
plot(pivot_drift_down_high ? 1.0 : 0.0, "dbg_high_vote_pivot_drift", display=display.data_window)
plot(vol_surge_high, "dbg_vol_surge_high", display=display.data_window)
plot(1.0 / vol_surge_thresh_high, "dbg_vol_surge_high_threshold", display=display.data_window)
plot(vol_surge_high < (1.0 / vol_surge_thresh_high) ? 1.0 : 0.0, "dbg_high_vote_volume", display=display.data_window)
plot(mom_diverge_high < 0 ? 1.0 : 0.0, "dbg_high_vote_momentum", display=display.data_window)
plot(mom_vel_high_ok ? 1.0 : 0.0, "dbg_high_vote_momentum_velocity", display=display.data_window)
plot(vola_elevated_high ? 1.0 : 0.0, "dbg_high_vote_volatility", display=display.data_window)
plot(gjr_high_vote ? 1.0 : 0.0, "dbg_high_vote_gjr", display=display.data_window)
plot(har_high_vote ? 1.0 : 0.0, "dbg_high_vote_har", display=display.data_window)
plot(price_high_ok ? 1.0 : 0.0, "price_gate_high", display=display.data_window)
plot(er_val_high, "er_val_high", display=display.data_window)
plot(baseline_ph, "baseline_pivot_high", display=display.data_window)

// Alerts.
alertcondition(pivot_high and not pivot_high[1], "Pivot High", "Speculatores V14: pivot HIGH")
alertcondition(pivot_low and not pivot_low[1], "Pivot Low", "Speculatores V14: pivot LOW")
